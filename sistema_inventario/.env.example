# Copia este archivo como .env y rellena los valores. El .env real NO se sube a git.

# --- Nube (Neon / Render): cadena de conexión completa ---
DATABASE_URL=

# --- Local (alternativa si no defines DATABASE_URL) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Clave para firmar las sesiones (JWT). Genera una distinta en cada entorno con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Opcionales (por defecto HS256 y 1440 minutos)
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# Orígenes permitidos por CORS, separados por comas (dominio de Vercel, sin "/" final)
CORS_ORIGINS=
